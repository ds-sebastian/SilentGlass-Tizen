# SilentGlass Home Assistant bridge. Normally written by the phone setup page (TV: Home > Info > Advanced settings).
# By hand: copy to silentglass-ha.conf, chmod 600, fill in your MQTT broker (user/password are optional).
host=192.168.1.10
port=1883
user=mqtt-user
password=change-me
name=Living Room TV
# Input names come from the TV (set on the TV or from HDMI-CEC); rename them from Home Assistant ("HDMI n name").
# Notifications (Home Assistant "Notifications for Android TV" integration, port 7676) are accepted only from the
# broker host above and from notify_from= (comma-separated addresses or names), if Home Assistant runs elsewhere.
#notify_from=192.168.1.20
# Override what each notification asks for (leave out for "as sent"): position bottom-right, bottom-left, top-right,
# top-left or center; size small, medium or large; seconds on screen 5, 10, 20 or 30; notify_images=0 drops pictures;
# notify_quiet=22:00-07:00 drops notifications in those hours (TV time).
#notify_position=top-right
#notify_size=medium
#notify_duration=10
#notify_images=0
#notify_quiet=22:00-07:00
# How often volume, mute and input names are checked, in seconds: 2, 5, 10 (default), 30 or 60. Power, input and the
# app on screen are sent when they change.
#update=10
