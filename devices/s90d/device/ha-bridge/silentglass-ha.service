[Unit]
Description=SilentGlass: Home Assistant bridge (MQTT discovery, notifications, phone setup page)
StartLimitIntervalSec=0
# runs unconfigured too: set it up from a phone (TV: Home > Info > Home Assistant), which writes
# /opt/usr/home/owner/.config/silentglass-ha.conf (mode 600)

[Service]
Type=simple
ExecStart=/usr/bin/dotnet /opt/usr/share/silentglass-ha/silentglass-ha.dll
Restart=always
RestartSec=20

[Install]
WantedBy=default.target
