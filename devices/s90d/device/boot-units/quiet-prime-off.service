[Unit]
Description=Quiet Home janitor: close Samsung boot preloads, and Samsung Home / Apple TV / Prime / browser after 5 min in the background (owner request)

[Service]
Type=simple
# Script is read on stdin (unsigned files cannot be executed under UEP). Log: /run/user/5001/quiet-prime-off.log
StandardInput=file:/opt/usr/home/owner/.config/quiet-home/prime-off.sh
ExecStart=/bin/sh -s

[Install]
WantedBy=default.target
