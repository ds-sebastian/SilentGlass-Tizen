[Unit]
Description=Quiet Home: keep USB port power on in standby (the Thread radio is a USB device)
StartLimitIntervalSec=0
# Quiet Home's Info switch: this marker in the launcher's data directory keeps the border router off (also at boot)
ConditionPathExists=!/opt/usr/home/owner/apps_rw/com.samsung.tv.bixby-promotion/data/thread-off

[Service]
Type=simple
# storaged powers the USB ports down ~20 min into standby unless a live process asked it not to; Samsung only asks
# while its SmartThings hub is on. The keeper asks, stays alive and repeats the request every 5 min.
ExecStart=/bin/sh -c 'exec >>/run/user/5001/quiet-otbr.log 2>&1; exec /usr/bin/dotnet /opt/usr/share/quiet-otbr/quiet-otbr-usbpower.dll on'
Restart=always
RestartSec=30

[Install]
WantedBy=default.target
