<Project Sdk="Microsoft.NET.Sdk">
  <!-- Off-TV check of the bridge's notification endpoint: serves ONE request on 127.0.0.1:7676 with the bridge's own
       reader/parser and prints what SilentGlass would get. Driven by tests/test_s90d_notice.py with Home Assistant's
       notifications-android-tv 0.1.5 client. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net6.0</TargetFramework>
    <Nullable>disable</Nullable>
    <StartupObject>NoticeHarness</StartupObject>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>
  <ItemGroup><Compile Include="../../devices/s90d/device/ha-bridge/src/*.cs" /><EmbeddedResource Include="../../devices/s90d/device/ha-bridge/src/setup.html" LogicalName="setup.html" /></ItemGroup>
</Project>
